{
  "name": "@canonical/vitest-config-react",
  "version": "0.42.0",
  "type": "module",
  "description": "Canonical's standard Vitest configuration factory for React packages",
  "main": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "author": {
    "email": "webteam@canonical.com",
    "name": "Canonical Webteam"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/pragma-web"
  },
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/canonical/pragma-web/issues"
  },
  "homepage": "https://github.com/canonical/pragma-web#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:all": "tsc -p tsconfig.build.json",
    "check": "bun run check:biome",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit"
  },
  "peerDependencies": {
    "typescript": "^5.9.3 || ^6.0.0 || ^7.0.0",
    "vite": "^8.0.1",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@canonical/biome-config": "0.43.0-experimental.0",
    "@canonical/typescript-config": "0.43.0-experimental.0",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.1",
    "vitest": "^5.0.0"
  }
}
