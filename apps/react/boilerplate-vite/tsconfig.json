{
  "extends": "@canonical/typescript-config-react",
  "compilerOptions": {
    "skipLibCheck": true,
    "types": [
      "bun-types",
      "node",
      "react",
      "react-dom",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "noEmit": true,
    "paths": {
      "#lib/*": ["./src/lib/*"],
      "#domains/*": ["./src/domains/*"],
      "#i18n/*": ["./src/i18n/*"],
      "#relay/*": ["./src/relay/*"],
      "#styles/*": ["./src/styles/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".storybook/*.ts",
    ".storybook/*.tsx",
    "vite.config.ts",
    "vite-plugin-ds-icons.ts",
    "vitest.setup.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts",
    "test/**/*.ts"
  ]
}
