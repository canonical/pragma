<% if (type === 'css') { -%>
// The stylesheet comes first, before anything that imports a component: CSS is
// emitted in the order the bundler evaluates the modules that import it, and
// the layer order a browser applies is the one it reads first.
import "../src/index.css";
<% } -%>
import previewConfig from "@canonical/storybook-config/preview";
import "@canonical/styles-debug/baseline-grid";
import type { Preview } from "@storybook/react-vite";

// The root declaration: one context (`app` | `site` | `docs`) and one density
// (`comfortable` | `dense`), which together choose the spacing and
// control-height channel every control reads. It goes on the document element,
// because a docs page renders several stories into one document, and at module
// scope, so the first paint already has it.
//
// Nothing else belongs here. `@canonical/storybook-addon-utils`, which
// `createConfig` registers, owns the light/dark toggle on this same element
// from its toolbar; writing a scheme here would make this file a second owner
// of it.
if (typeof document !== "undefined") {
  document.documentElement.classList.add("app", "comfortable");
}

const preview = {
  ...previewConfig,
  // Storybook statically parses `preview.ts` for `storySort` and requires the
  // order to be an inline literal — an imported const is rejected — and it
  // does not reliably merge `tags`/`parameters` spread from an imported
  // preview. So both are declared inline here rather than inherited from
  // `@canonical/storybook-config`.
  // https://github.com/storybookjs/storybook/issues/31842
  tags: ["autodocs"],
  parameters: {
    ...previewConfig.parameters,
    options: {
      storySort: {
        order: [
          "Documentation",
          "subcomponents",
          "components",
          "groups",
          "patterns",
          "common",
          "utils",
          "_work_in_progress",
        ],
      },
    },
  },
};

export default preview;
