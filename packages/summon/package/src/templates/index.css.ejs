/**
 * <%= name %>
 *
 * <%= description || 'TODO: Add description' %>
 */
<% if (componentLayer) { %><% if (layerOrderFrom) { %>
/* The layer order first, then this package's layer. A layer takes its place
 * the moment a browser first meets its name, so a name met before the order is
 * read is placed below the layers that order declares. Which file a bundler
 * emits first is not something this package can control from inside itself;
 * reading the order here settles it. Reading it twice costs nothing: an order
 * statement can add names, never reorder the ones already fixed. */
@import url("<%= layerOrderFrom %>");
<% } else { %>
/* This package's layer, declared before any sheet writes into it. */
<% } %>@layer <%= componentLayer %>;
<% } %>
