{
  "name": "<%= name %>",
  "description": "<%= description %>",
  "version": "<%= version %>",
  "type": "module",
<% if (type === 'css') { -%>
  "module": "<%= moduleEntry %>",
<% } else if (needsBuild) { -%>
  "main": "<%= moduleEntry %>",
  "module": "<%= moduleEntry %>",
  "types": "<%= typesEntry %>",
  "exports": {
    ".": {
      "types": "./<%= typesEntry %>",
      "import": "./<%= moduleEntry %>"
    }
  },
<% } else { -%>
  "module": "<%= moduleEntry %>",
  "types": "<%= typesEntry %>",
<% } -%>
<% if (withCli && type !== 'css') { -%>
  "bin": {
    "<%= shortName %>": "<%= needsBuild ? 'dist/esm/cli.js' : 'src/cli.ts' %>"
  },
<% } -%>
  "files": [
<% if (type === 'tool-ts' || type === 'css') { -%>
    "src"
<% } else { -%>
    "dist"
<% } -%>
  ],
  "author": {
    "email": "webteam@canonical.com",
    "name": "Canonical Webteam"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/pragma"
  },
  "license": "<%= license %>",
  "bugs": {
    "url": "https://github.com/canonical/pragma/issues"
  },
  "homepage": "https://github.com/canonical/pragma#readme",
  "scripts": {
<% if (type === 'tool-ts' || type === 'css') { -%>
    "build": "echo 'No build needed'",
<% } else { -%>
    "build": "tsc -p tsconfig.build.json",
<% } -%>
<% if (withStorybook) { -%>
    "build:all": "bun run build && bun run build:storybook",
    "build:storybook": "storybook build",
<% } else { -%>
    "build:all": "bun run build",
<% } -%>
<% if (type === 'css') { -%>
    "check": "bun run check:biome && bun run check:webarchitect",
    "check:fix": "bun run check:biome:fix",
<% } else { -%>
    "check": "bun run check:biome && bun run check:ts && bun run check:webarchitect",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
<% } -%>
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
<% if (type !== 'css') { -%>
    "check:ts": "tsc --noEmit",
<% } -%>
    "check:webarchitect": "webarchitect <%= ruleset %>",
<% if (withStorybook) { -%>
    "storybook": "storybook dev -p 6006 --no-open --host 0.0.0.0",
<% } -%>
<% if (type === 'css') { -%>
    "test": "echo 'No tests for CSS package'"
<% } else { -%>
    "test": "vitest run",
    "test:watch": "vitest"
<% } -%>
  },
<% if (type !== 'css') { -%>
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@canonical/biome-config": "^<%= canonicalVersion %>",
<% if (withStorybook) { -%>
    "@canonical/styles-debug": "^<%= canonicalVersion %>",
<% } -%>
<% if (framework === 'react') { -%>
    "@canonical/typescript-config-react": "^<%= canonicalVersion %>",
<% } else { -%>
    "@canonical/typescript-config": "^<%= canonicalVersion %>",
<% } -%>
    "@canonical/webarchitect": "^<%= canonicalVersion %>",
<% if (withStorybook) { -%>
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-themes": "^10.3.1",
    "@storybook/react-vite": "^10.3.1",
<% } -%>
<% if (framework === 'react') { -%>
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
<% } -%>
    "bun-types": "^1.0.0",
<% if (framework === 'react') { -%>
    "jsdom": "^28.1.0",
<% } -%>
<% if (withStorybook && framework !== 'react') { -%>
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
<% } -%>
<% if (withStorybook) { -%>
    "storybook": "^10.3.1",
<% } -%>
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }<% if (withStorybook || framework === 'react') { %>,
  "dependencies": {
<% if (withStorybook) { -%>
    "@canonical/storybook-config": "^<%= canonicalVersion %>"<%= framework === 'react' ? "," : "" %>
<% } -%>
<% if (framework === 'react') { -%>
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
<% } -%>
  }<% } %>
<% } else { -%>
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@canonical/biome-config": "^<%= canonicalVersion %>",
<% if (withStorybook) { -%>
    "@canonical/storybook-config": "^<%= canonicalVersion %>",
    "@canonical/styles-debug": "^<%= canonicalVersion %>",
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-themes": "^10.3.1",
    "@storybook/react-vite": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.3.1",
<% } -%>
    "@canonical/webarchitect": "^<%= canonicalVersion %>"
  }
<% } -%>
}
