<!doctype html>
<!-- The root declaration: one context (`app`, `site` or `docs`) and one density
     (`comfortable` or `dense`), which together choose the --density-* channel
     every control reads. A colour scheme is optional — `light` or `dark` pins
     one, leaving both off follows the reader's operating system.

     Those classes are the whole of it. Nothing on this element declares the
     design system itself: its stylesheet applies to the page as it stands. -->
<html lang="en" class="app comfortable">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<% if (spa) { -%>
    <meta name="description" content="<%= name %> — a React application built with the Canonical design system and router packages." />
<% } else { -%>
    <meta name="description" content="<%= name %> — a React application built with the Canonical design system, router, and SSR packages." />
<% } -%>
    <link rel="icon" type="image/png" sizes="32x32" href="https://assets.ubuntu.com/v1/be7e4cc6-COF-favicon-32x32.png">
    <title><%= name %></title>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/client/entry.tsx"></script>
  </body>
</html>
