<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<% if (spa) { -%>
    <meta name="description" content="<%= name %> — a React application built with the Canonical design system and router packages." />
<% } else { -%>
    <meta name="description" content="<%= name %> — a React application built with the Canonical design system, router, and SSR packages." />
<% } -%>
    <link rel="icon" type="image/png" sizes="32x32" href="https://assets.ubuntu.com/v1/be7e4cc6-COF-favicon-32x32.png">
    <title><%= name %></title>
  </head>
  <!-- Surface declaration: context (app) + density (comfortable) — roots the design system's --density-* channel -->
  <body class="app comfortable">
    <div id="root"></div>
    <script type="module" src="/src/client/entry.tsx"></script>
  </body>
</html>
