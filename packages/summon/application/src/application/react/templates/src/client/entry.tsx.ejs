// — so the first `useLazyLoadQuery` and any warm hook fired during router
// construction share one store. A client-only app has no server-captured
// payload to seed from, so the store starts empty and the first query fetches.
const relayEnvironment = getBrowserEnvironment();
<% } -%>
<% if (relay && !spa) { -%>

// Seed the browser-session Relay environment FIRST — before the router exists
