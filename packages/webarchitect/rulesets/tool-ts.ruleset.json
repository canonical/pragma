{
  "$schema": "https://raw.githubusercontent.com/canonical/pragma/refs/heads/main/packages/webarchitect/src/schema.json",
  "name": "tool-ts",
  "extends": ["base"],
  "variables": {
    "prefix": {
      "default": "@canonical/",
      "schema": { "type": "string" }
    }
  },
  "biome": {
    "file": {
      "name": "biome.json",
      "contains": {
        "type": "object",
        "properties": {
          "$schema": {
            "type": "string"
          },
          "extends": {
            "type": "array",
            "items": { "const": "@canonical/biome-config" },
            "minItems": 1,
            "maxItems": 1
          },
          "files": {
            "type": "object",
            "properties": {
              "includes": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false,
            "description": "File inclusion patterns only"
          }
        },
        "required": ["extends"],
        "additionalProperties": false
      }
    }
  },
  "package-structure": {
    "file": {
      "name": "package.json",
      "contains": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^${prefix}"
          },
          "version": {
            "type": "string"
          },
          "type": {
            "const": "module"
          },
          "module": {
            "const": "src/index.ts"
          },
          "types": {
            "const": "src/index.ts"
          },
          "files": {
            "type": "array",
            "contains": { "const": "src" }
          },
          "scripts": {
            "type": "object",
            "properties": {
              "build": {
                "type": "string",
                "description": "Build command (can be no-op for TS-only packages)"
              },
              "build:all": {
                "type": "string",
                "description": "Full artifact build — the command CI lanes fan out to"
              },
              "test": {
                "type": "string",
                "description": "Test command (implementation flexible)"
              },
              "check:ts": {
                "const": "tsc --noEmit"
              }
            },
            "required": ["build", "test", "check:ts"],
            "$comment": "if/then rather than 2020-12's dependentRequired: the validator is ajv's draft-07 class, which silently ignores unknown keywords",
            "if": { "required": ["build"] },
            "then": { "required": ["build:all"] }
          }
        },
        "required": [
          "name",
          "version",
          "type",
          "module",
          "types",
          "files",
          "scripts"
        ]
      }
    }
  },
  "package-license": {
    "file": {
      "name": "package.json",
      "contains": {
        "type": "object",
        "properties": {
          "license": {
            "const": "GPL-3.0"
          }
        },
        "required": ["license"]
      }
    }
  }
}
