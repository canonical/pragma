{
  "name": "@canonical/ds-assets",
  "description": "Assets for Pragma.",
  "version": "0.34.0",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./icons/*": "./icons/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts",
    "icons"
  ],
  "author": {
    "email": "webteam@canonical.com",
    "name": "Canonical Webteam"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/pragma"
  },
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/canonical/pragma/issues"
  },
  "homepage": "https://github.com/canonical/pragma#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:package",
    "build:all": "bun run build:package",
    "build:package": "bun run build:icons-manifest && bun run build:package:tsc",
    "build:package:tsc": "tsc -p tsconfig.build.json",
    "build:icons-manifest": "bun run scripts/build-icon-manifest.ts && biome check --write src/icons/manifest.generated.ts",
    "check": "bun run check:biome && bun run check:ts && bun run check:webarchitect",
    "check:webarchitect": "webarchitect library",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "test": "bun run test:vitest",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@canonical/biome-config": "^0.34.0",
    "@canonical/typescript-config": "^0.34.0",
    "@canonical/webarchitect": "^0.34.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.12.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.0.18"
  }
}
