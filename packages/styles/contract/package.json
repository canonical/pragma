{
  "name": "@canonical/styles-contract",
  "description": "The Canonical Design System's cascade contract, in executable form: the tests that hold @canonical/styles' entry points to what its README promises.",
  "version": "0.37.0",
  "private": true,
  "type": "module",
  "author": {
    "email": "webteam@canonical.com",
    "name": "Canonical Webteam"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/pragma"
  },
  "license": "LGPL-3.0",
  "scripts": {
    "check": "bun run check:biome && bun run check:ts",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@canonical/biome-config": "^0.37.0",
    "@canonical/styles": "^0.37.0",
    "@canonical/typescript-config": "^0.37.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.0.18"
  }
}
