{
  "name": "@canonical/pragma-cli",
  "description": "CLI and MCP server over Canonical's design-system knowledge graph.",
  "version": "0.36.0",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "pragma": "dist/src/bin.js"
  },
  "files": [
    "src",
    "dist",
    "pragma.conf.ts",
    "bundled-skills"
  ],
  "author": {
    "email": "webteam@canonical.com",
    "name": "Canonical Webteam"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/pragma"
  },
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/canonical/pragma/issues"
  },
  "homepage": "https://github.com/canonical/pragma#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:all": "bun run build",
    "bundle": "bun run scripts/bundle.ts",
    "gen:reference": "bun run scripts/genReference.ts",
    "check": "bun run check:biome && bun run check:ts && bun run check:webarchitect && bun run check:packs",
    "check:packs": "bun run scripts/check-pack-parity.ts",
    "check:packs:test": "bun test scripts/check-pack-parity.test.ts",
    "check:webarchitect": "webarchitect tool-ts",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "test": "bun run check:packs:test && bun run test:vitest",
    "test:vitest": "vitest run --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "bun run src/testing/eval/report.ts"
  },
  "dependencies": {
    "@canonical/harnesses": "^0.36.0",
    "@canonical/ke": "^0.36.0",
    "@canonical/ke-graphql": "^0.36.0",
    "@canonical/summon-application": "^0.36.0",
    "@canonical/summon-component": "^0.36.0",
    "@canonical/summon-core": "^0.36.0",
    "@canonical/summon-package": "^0.36.0",
    "@canonical/task": "^0.36.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "graphql": "17.0.0-rc.0",
    "oxigraph": "^0.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@canonical/anatomy-dsl": "^0.3.0",
    "@canonical/biome-config": "^0.36.0",
    "@canonical/summon": "^0.36.0",
    "@canonical/token-ontology": "^0.8.1",
    "@canonical/typescript-config": "^0.36.0",
    "@canonical/webarchitect": "^0.36.0",
    "@types/bun": "^1.3.10",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.18 <23 || >=23.6"
  }
}
