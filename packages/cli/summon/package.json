{
  "name": "@canonical/summon",
  "description": "Summon CLI binary: interactive code generator with Ink UI, shell completion, and Commander registration.",
  "version": "0.36.0",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "summon": "dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/bin.d.ts",
      "import": "./dist/src/bin.js"
    },
    "./ui": {
      "types": "./dist/src/ui/index.d.ts",
      "import": "./dist/src/ui/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "author": {
    "email": "webteam@canonical.com",
    "name": "Canonical Webteam"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/pragma"
  },
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/canonical/pragma/issues"
  },
  "homepage": "https://github.com/canonical/pragma#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun ../../../scripts/copy-templates.ts generators dist/generators",
    "build:all": "bun run build",
    "check": "bun run check:biome && bun run check:ts && bun run check:ts:build && bun run check:webarchitect",
    "check:fix": "bun run check:biome:fix && bun run check:ts && bun run check:ts:build",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "check:ts:build": "tsc -p tsconfig.build.json --noEmit",
    "check:webarchitect": "webarchitect tool-ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@canonical/summon-core": "^0.36.0",
    "@canonical/task": "^0.36.0",
    "@canonical/utils": "^0.36.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "ink": "^6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "omelette": "^0.4.17",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@canonical/biome-config": "^0.36.0",
    "@canonical/typescript-config": "^0.36.0",
    "@canonical/webarchitect": "^0.36.0",
    "@types/bun": "^1.3.10",
    "@types/node": "^26.0.0",
    "@types/omelette": "^0.4.5",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.18 <23 || >=23.6"
  }
}
